# Kinesis band service (systemd user unit). install.sh fills in @BUN@ and @REPO@.
[Unit]
Description=Kinesis: Meta Neural Band controls
Documentation=file://@REPO@/README.md
After=graphical-session.target bluetooth.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@BUN@ run @REPO@/src/cli.ts daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
